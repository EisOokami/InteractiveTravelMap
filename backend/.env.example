# ─── Runtime ──────────────────────────────────────────────────────────────────
# development | production (production sets the Secure flag on cookies).
NODE_ENV=development
# Port of the API.
PORT=3001

# ─── Database (MySQL / MariaDB) ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=interactive_travel_map

# ─── Secrets (generate long random values, e.g. `openssl rand -hex 32`) ───────
# Sign access and refresh tokens.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Signs CSRF tokens.
CSRF_SECRET=
# Encrypts stored 2FA secrets; at least 32 characters.
MFA_ENCRYPTION_KEY=
# Sign the e-mail codes for login and account deletion.
LOGIN_CODE_SECRET=
DELETION_CODE_SECRET=
# Optional, at least 32 characters, the same value as in frontend/.env. Lets the
# API trust the visitor IP forwarded by the Next.js server (per-visitor rate
# limits). Without it forwarded addresses are ignored.
BFF_SHARED_SECRET=

# ─── URLs, CORS and hosts ─────────────────────────────────────────────────────
# Public frontend URL: e-mail links and Google sign-in redirects.
WEB_URL=http://localhost:3000
# Comma-separated host names (with port) the API answers to.
HOSTS="127.0.0.1:3000,localhost:3000,localhost:3001,127.0.0.1:3001"
# Comma-separated origins allowed to call the API.
CORS_URLS="http://127.0.0.1:3000,http://localhost:3000,http://localhost:3001,http://127.0.0.1:3001"
# Trusted proxies in front of the API (addresses or subnets, comma-separated,
# e.g. `loopback`). Empty = X-Forwarded-For is ignored.
TRUST_PROXY=

# ─── Legal documents ──────────────────────────────────────────────────────────
# Required. Versions of the Terms of Service and Privacy Policy (/terms,
# /privacy). After a bump every account has to accept the new versions. Keep
# them equal to the frontend values.
TERMS_VERSION=1.0
PRIVACY_VERSION=1.0

# ─── E-mail (Nodemailer) ──────────────────────────────────────────────────────
# Nodemailer well-known service (e.g. gmail) and the sender mailbox.
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASSWORD=

# ─── Google sign-in ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# <API URL>/auth/google/callback, registered in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# ─── AI trip assistant ────────────────────────────────────────────────────────
# Gemini model (default gemini-3.5-flash-lite). There is no server key: each user
# adds their own Gemini API key in the AI Trip Assistant.
GEMINI_MODEL=gemini-3.5-flash-lite

# ─── Logs ─────────────────────────────────────────────────────────────────────
# trace | debug | info | warn | error (default info).
LOG_LEVEL=info
# Optional log file, rotated daily and kept for 30 days. Empty = stdout.
# Set ./logs/app.log to feed Loki/Grafana (docker-compose.yml).
LOG_FILE=
