# Root .env for docker-compose.yml (Loki, Promtail and Grafana for the API logs).
# The API and the web app use backend/.env and frontend/.env.
# Set LOG_FILE=./logs/app.log in backend/.env so Promtail can read the logs.

# Grafana administrator (Grafana is published on 127.0.0.1:3200 only).
GRAFANA_ADMIN_USER=admin
# Required: docker compose refuses to start without it.
GRAFANA_ADMIN_PASSWORD=
# true lets anyone create a Grafana account; keep false.
GRAFANA_ALLOW_SIGN_UP=false
# Optional comma-separated Grafana plugins to install.
GRAFANA_INSTALL_PLUGINS=
