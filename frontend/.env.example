# ─── API ──────────────────────────────────────────────────────────────────────
# Public API address (used by the browser and by most server-side requests).
NEXT_PUBLIC_DB_URL=http://localhost:3001
# API address used by the server to refresh sessions; usually the same value.
DB_URL=http://localhost:3001

# ─── Maps ─────────────────────────────────────────────────────────────────────
# Mapbox token: satellite layer and route planning.
NEXT_PUBLIC_MAPBOX_API_KEY=
# Thunderforest key: cycling map layer.
NEXT_PUBLIC_THUNDERFOREST_API_KEY=

# ─── Cookies ──────────────────────────────────────────────────────────────────
# Domain of the session cookies (default localhost). Set your domain in production.
HOST=localhost

# ─── Visitor IP forwarding ────────────────────────────────────────────────────
# Same value as BFF_SHARED_SECRET of the API (at least 32 characters). Without it
# the API counts rate limits per Next.js server instead of per visitor.
BFF_SHARED_SECRET=
# Header with the visitor address set by the proxy in front of Next.js (e.g.
# x-real-ip behind nginx with `proxy_set_header X-Real-IP $remote_addr`).
# Leave empty locally and on Vercel (x-real-ip is used automatically there).
# Never use a header the browser can set itself, such as x-forwarded-for.
CLIENT_IP_HEADER=

# ─── Legal documents (/privacy, /terms) ───────────────────────────────────────
# Public address of the service shown in the documents.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Versions shown on the pages; keep them equal to the API values.
TERMS_VERSION=1.0
PRIVACY_VERSION=1.0
# Dates shown in the documents, e.g. "20 listopada 2026 r.".
LEGAL_LAST_TERMS_UPDATED=
LEGAL_EFFECTIVE_TERMS_DATE=
LEGAL_LAST_PRIVACY_UPDATED=
LEGAL_EFFECTIVE_PRIVACY_DATE=
# Operator (data controller) and contact e-mail.
LEGAL_OPERATOR=
LEGAL_CONTACT_EMAIL=
# Server provider and country, e.g. "Hetzner Online GmbH (Niemcy)".
LEGAL_SERVER_PROVIDER=
# Backup retention, e.g. "do 30 dni".
LEGAL_BACKUP_RETENTION=
# Repository and license links (default: this repository on GitHub).
LEGAL_REPOSITORY_URL=
LEGAL_LICENSE_URL=
# Empty values show a highlighted [DO UZUPEŁNIENIA] placeholder on the pages.

# NODE_ENV is set by Next.js (next dev / next build); VERCEL is set by Vercel.
